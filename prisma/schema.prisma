generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                       @id @default(cuid())
  name                  String
  email                 String                       @unique
  emailVerifiedAt       DateTime?
  passwordHash          String
  globalRole            UserGlobalRole               @default(STUDENT)
  isActive              Boolean                      @default(true)
  deactivatedAt         DateTime?
  deactivatedById       String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  purchases             Purchase[]
  memberships           CourseMembership[]
  moduleProgress        CourseModuleProgress[]
  forumThreads          ForumThread[]
  forumPosts            ForumPost[]
  forumNotifications    ForumNotification[]
  notifications         UserNotification[]
  notificationPreference NotificationPreference?
  courseAssignments     CourseTeacherAssignment[]
  editionAssignments    CourseEditionTeacherAssignment[]
  courseResources       CourseResource[]             @relation("CourseResourceCreatedBy")
  resourceSubmissions   CourseResourceSubmission[]   @relation("CourseResourceSubmissionStudent")
  reviewedSubmissions   CourseResourceSubmission[]   @relation("CourseResourceSubmissionReviewer")
  enrollments           CourseEnrollment[]
  createdPromotions     Promotion[]                  @relation("PromotionCreatedBy")
  updatedPromotions     Promotion[]                  @relation("PromotionUpdatedBy")
  promotionRedemptions  PromotionRedemption[]
  auditLogs             AuditLog[]                   @relation("AuditActor")
  passwordResetTokens   UserPasswordResetToken[]
  emailVerificationTokens UserEmailVerificationToken[]
  sessions              UserSession[]
  deactivatedBy         User?                        @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivatedUsers      User[]                       @relation("UserDeactivatedBy")
  libraryResources      LibraryResource[]            @relation("LibraryResourceUploadedBy")
  libraryFolders        LibraryFolder[]              @relation("LibraryFolderCreatedBy")
  calendarEvents        CalendarEvent[]              @relation("CalendarEventCreatedBy")
  sentMessages          DirectMessage[]              @relation("SentMessages")
  receivedMessages      DirectMessage[]              @relation("ReceivedMessages")
}

model Course {
  id               String                    @id @default(cuid())
  slug             String                    @unique
  title            String
  shortDescription String
  description      String                    @db.LongText
  priceInCents     Int
  duration         String
  format           String
  level            String
  accentFrom       String
  accentTo         String
  coverImageStorageKey String?
  coverImageMimeType   String?
  category         String
  audienceJson     Json
  outcomesJson     Json
  methodologyJson  Json
  faqJson          Json
  seoTitle         String
  seoDescription   String
  status           CourseStatus              @default(ACTIVE)
  clonedFromId     String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  modules          CourseModule[]
  editions         CourseEdition[]
  resources        CourseResource[]
  teacherAssignments CourseTeacherAssignment[]
  purchases        Purchase[]
  enrollments      CourseEnrollment[]
  promotions       Promotion[]
  promotionRedemptions PromotionRedemption[]
  legacyMemberships CourseMembership[]
  legacyModuleProgress CourseModuleProgress[]
  forumSpaces      ForumSpace[]
  forumCategories  ForumCategory[]
  forumNotifications ForumNotification[]
  forumAuditLogs   ForumAuditLog[]
  clonedFrom       Course?                   @relation("CourseClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones           Course[]                  @relation("CourseClones")
  libraryResources LibraryResource[]
  libraryFolders   LibraryFolder[]
  calendarEvents   CalendarEvent[]
}

model CourseModule {
  id               String    @id @default(cuid())
  courseId         String
  moduleKey        String
  title            String
  description      String    @db.LongText
  estimatedTime    String
  resourcesSummary String
  position         Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources        CourseResource[]

  @@unique([courseId, moduleKey])
  @@index([courseId, position])
}

model CourseResource {
  id          String               @id @default(cuid())
  courseId    String
  moduleId    String?
  createdById String
  type        CourseResourceType
  source      CourseResourceSource
  title       String
  description String?              @db.LongText
  linkUrl     String?
  storageKey  String?
  mimeType    String?
  sizeInBytes Int?
  dueAt       DateTime?
  passingScore Float?
  isPublished Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("CourseResourceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  submissions      CourseResourceSubmission[]
  rubricCriteria   RubricCriterion[]

  @@index([courseId, isPublished, sortOrder, createdAt])
  @@index([moduleId, sortOrder])
  @@index([createdById, createdAt])
}

model CourseResourceSubmission {
  id           String                         @id @default(cuid())
  resourceId   String
  studentId    String
  reviewerId   String?
  body         String?                        @db.LongText
  linkUrl      String?
  storageKey   String?
  attachmentLabel String?
  mimeType     String?
  sizeInBytes  Int?
  status       CourseResourceSubmissionStatus @default(SUBMITTED)
  score        Float?
  feedback     String?                        @db.LongText
  submittedAt  DateTime                       @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  resource     CourseResource                 @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student      User                           @relation("CourseResourceSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?                          @relation("CourseResourceSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  rubricScores     RubricScore[]

  @@unique([resourceId, studentId])
  @@index([resourceId, status, submittedAt])
  @@index([studentId, submittedAt])
  @@index([reviewerId, reviewedAt])
}

model CourseEdition {
  id               String                       @id @default(cuid())
  courseId         String
  label            String
  editionNumber    Int
  status           CourseEditionStatus          @default(ACTIVE)
  startsAt         DateTime?
  endsAt           DateTime?
  graceAccessDays  Int                          @default(0)
  accessUntil      DateTime?
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  course           Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherAssignments CourseEditionTeacherAssignment[]
  enrollments      CourseEnrollment[]
  purchases        Purchase[]

  @@unique([courseId, editionNumber])
  @@index([courseId, isActive, status])
}

model CourseTeacherAssignment {
  id           String   @id @default(cuid())
  courseId     String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model CourseEditionTeacherAssignment {
  id             String       @id @default(cuid())
  courseEditionId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  courseEdition  CourseEdition @relation(fields: [courseEditionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseEditionId, userId])
  @@index([userId])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  courseId                String
  courseEditionId         String?
  status                  PurchaseStatus @default(PENDING)
  subtotalInCents         Int
  discountInCents         Int            @default(0)
  taxInCents              Int            @default(0)
  totalInCents            Int
  promotionId             String?
  promotionCode           String?
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  courseSlugSnapshot      String
  courseTitleSnapshot     String
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseEdition           CourseEdition? @relation(fields: [courseEditionId], references: [id], onDelete: SetNull)
  promotion               Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  enrollment              CourseEnrollment?
  promotionRedemption     PromotionRedemption?

  @@index([userId, courseId, status])
  @@index([courseEditionId, status])
}

model PaymentWebhookEvent {
  id            String                    @id @default(cuid())
  stripeEventId String                    @unique
  type          String
  payloadHash   String
  status        PaymentWebhookEventStatus
  attemptCount  Int                       @default(0)
  processingStartedAt DateTime?
  lastAttemptAt DateTime?
  lastError     String?                   @db.LongText
  processedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status, createdAt])
  @@map("payment_webhook_events")
}

model CourseEnrollment {
  id              String                 @id @default(cuid())
  userId          String
  courseId        String
  courseEditionId String?
  purchaseId      String?                @unique
  status          CourseEnrollmentStatus @default(ACTIVE)
  accessStartsAt  DateTime               @default(now())
  accessUntil     DateTime?
  deactivatedAt   DateTime?
  deactivatedById String?
  notes           String?                @db.LongText
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseEdition   CourseEdition?         @relation(fields: [courseEditionId], references: [id], onDelete: SetNull)
  purchase        Purchase?              @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@index([courseEditionId, status])
}

model Promotion {
  id              String                @id @default(cuid())
  code            String                @unique
  description     String?               @db.LongText
  discountType    PromotionDiscountType
  amountInCents   Int
  isActive        Boolean               @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  usageLimit      Int?
  scope           PromotionScope        @default(GLOBAL)
  courseId        String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  course          Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("PromotionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchases       Purchase[]
  redemptions     PromotionRedemption[]

  @@index([isActive, code])
  @@index([courseId, isActive])
}

model PromotionRedemption {
  id              String    @id @default(cuid())
  promotionId     String
  purchaseId      String    @unique
  userId          String
  courseId        String
  discountInCents Int
  createdAt       DateTime  @default(now())
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  purchase        Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  userId       String   @id
  emailEnabled Boolean  @default(true)
  webEnabled   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotification {
  id           String               @id @default(cuid())
  userId       String
  category     NotificationCategory
  title        String
  body         String               @db.LongText
  linkPath     String
  metadataJson String?              @db.LongText
  readAt       DateTime?
  createdAt    DateTime             @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?
  action       AuditAction
  entityType   AuditEntityType
  entityId     String
  entityLabel  String?
  metadataJson String?         @db.LongText
  createdAt    DateTime        @default(now())
  actor        User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model StoredAsset {
  storageKey  String   @id
  content     Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserPasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserEmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  bucket    String
  keyHash   String
  hitCount  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucket, keyHash])
  @@index([resetAt])
}

model CourseMembership {
  id         String     @id @default(cuid())
  userId     String
  courseId   String?
  courseSlug String
  role       CourseRole @default(STUDENT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseSlug])
  @@index([courseSlug, role])
  @@index([courseId, role])
}

model CourseModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  courseSlug  String
  moduleId    String   @default("")
  moduleIndex Int?
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseSlug, moduleId])
  @@index([userId, courseSlug, moduleIndex])
  @@index([userId, courseSlug])
  @@index([courseSlug])
  @@index([userId, courseId, moduleIndex])
  @@index([userId, courseId])
  @@index([courseId])
}

model ForumSpace {
  id            String            @id @default(cuid())
  courseId      String?
  courseSlug    String
  editionLabel  String
  editionNumber Int
  status        ForumSpaceStatus  @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  archivedAt    DateTime?
  archivedById  String?
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  course        Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  categories    ForumCategory[]

  @@index([courseSlug, status])
  @@unique([courseSlug, editionNumber])
  @@index([courseId, status])
}

model ForumCategory {
  id           String        @id @default(cuid())
  courseId     String?
  courseSlug   String
  forumSpaceId String?
  slug         String
  title        String
  description  String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  forumSpace   ForumSpace?   @relation(fields: [forumSpaceId], references: [id], onDelete: Cascade)
  threads      ForumThread[]

  @@unique([forumSpaceId, slug])
  @@index([courseSlug, sortOrder])
  @@index([courseSlug, slug])
  @@index([courseId, sortOrder])
  @@index([courseId, slug])
  @@index([forumSpaceId, sortOrder])
}

model ForumThread {
  id             String           @id @default(cuid())
  categoryId     String
  authorId       String
  authorRole     CourseRole
  type           ForumThreadType  @default(DISCUSSION)
  title          String
  body           String           @db.LongText
  isPinned       Boolean          @default(false)
  isClosed       Boolean          @default(false)
  isResolved     Boolean          @default(false)
  resolvedPostId String?
  isReadOnly     Boolean          @default(false)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedById    String?
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category       ForumCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  resolvedPost   ForumPost?       @relation("ResolvedForumPost", fields: [resolvedPostId], references: [id], onDelete: SetNull)
  posts          ForumPost[]
  attachments    ForumAttachment[]
  reports        ForumReport[]

  @@index([categoryId, isPinned, lastActivityAt])
  @@index([categoryId, type, deletedAt])
}

model ForumPost {
  id                String           @id @default(cuid())
  threadId          String
  authorId          String
  authorRole        CourseRole
  body              String           @db.LongText
  editedAt          DateTime?
  deletedAt         DateTime?
  deletedById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  author            User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread            ForumThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  resolvedByThreads ForumThread[]    @relation("ResolvedForumPost")
  attachments       ForumAttachment[]
  reports           ForumReport[]

  @@index([threadId, createdAt])
  @@index([threadId, deletedAt])
}

model ForumAttachment {
  id          String              @id @default(cuid())
  threadId    String?
  postId      String?
  kind        ForumAttachmentKind
  label       String
  url         String
  mimeType    String?
  sizeInBytes Int?
  storageKey  String?
  createdById String
  createdAt   DateTime            @default(now())
  thread      ForumThread?        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post        ForumPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([postId])
}

model ForumReport {
  id           String            @id @default(cuid())
  threadId     String?
  postId       String?
  reportedById String
  reason       String
  notes        String?           @db.LongText
  status       ForumReportStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  thread       ForumThread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post         ForumPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([threadId])
  @@index([postId])
}

model ForumNotification {
  id         String                @id @default(cuid())
  userId     String
  courseId   String?
  courseSlug String
  type       ForumNotificationType
  title      String
  body       String                @db.LongText
  linkPath   String
  readAt     DateTime?
  createdAt  DateTime              @default(now())
  course     Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([courseId, createdAt])
}

model ForumAuditLog {
  id          String          @id @default(cuid())
  courseId    String?
  courseSlug  String
  forumSpaceId String?
  threadId    String?
  postId      String?
  actorId     String
  actorRole   CourseRole
  action      ForumAuditAction
  metadataJson String?        @db.LongText
  createdAt   DateTime        @default(now())
  course      Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseSlug, createdAt])
  @@index([courseId, createdAt])
  @@index([forumSpaceId, createdAt])
  @@index([threadId, createdAt])
}

enum UserGlobalRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum CourseEditionStatus {
  ACTIVE
  SCHEDULED
  CLOSED
  CANCELLED
}

enum CourseEnrollmentStatus {
  ACTIVE
  CANCELLED
  REVOKED
  EXPIRED
}

enum CourseResourceType {
  MATERIAL
  EXERCISE
}

enum CourseResourceSource {
  FILE
  LINK
}

enum CourseResourceSubmissionStatus {
  SUBMITTED
  REVIEWED
  CHANGES_REQUESTED
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  GLOBAL
  COURSE
}

enum NotificationCategory {
  PURCHASE
  COURSE
  FORUM
  SYSTEM
}

enum AuditEntityType {
  USER
  COURSE
  COURSE_EDITION
  COURSE_ENROLLMENT
  COURSE_RESOURCE
  COURSE_RESOURCE_SUBMISSION
  PROMOTION
  PURCHASE
  NOTIFICATION_PREFERENCE
}

enum AuditAction {
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_CLONED
  COURSE_TEACHER_ASSIGNED
  COURSE_TEACHER_UNASSIGNED
  COURSE_EDITION_TEACHER_ASSIGNED
  COURSE_EDITION_TEACHER_UNASSIGNED
  COURSE_ARCHIVED
  EDITION_CREATED
  EDITION_UPDATED
  EDITION_CLOSED
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_ADMIN_GRANTED
  USER_ADMIN_REVOKED
  USER_TEACHER_GRANTED
  USER_TEACHER_REVOKED
  ENROLLMENT_CREATED
  ENROLLMENT_DEACTIVATED
  ENROLLMENT_REACTIVATED
  PROMOTION_CREATED
  PROMOTION_UPDATED
  PROMOTION_ACTIVATED
  PROMOTION_DEACTIVATED
  PURCHASE_CREATED
  PURCHASE_PAID
  PURCHASE_FAILED
  PROMOTION_APPLIED
  NOTIFICATION_PREFERENCES_UPDATED
  COURSE_RESOURCE_CREATED
  COURSE_RESOURCE_UPDATED
  COURSE_RESOURCE_DELETED
  COURSE_RESOURCE_PUBLISHED
  COURSE_RESOURCE_UNPUBLISHED
  COURSE_RESOURCE_REORDERED
  COURSE_RESOURCE_SUBMISSION_CREATED
  COURSE_RESOURCE_SUBMISSION_UPDATED
  COURSE_RESOURCE_SUBMISSION_REVIEWED
  COURSE_RESOURCE_SUBMISSION_CHANGES_REQUESTED
}

enum CourseRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ForumSpaceStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ForumThreadType {
  DISCUSSION
  ANNOUNCEMENT
}

enum ForumAttachmentKind {
  FILE
  IMAGE
  LINK
  VIDEO
}

enum ForumReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ForumNotificationType {
  THREAD_REPLY
  MENTION
  TEACHER_ANNOUNCEMENT
  THREAD_REPORTED
  MODERATION_ACTION
}

enum ForumAuditAction {
  THREAD_CREATED
  THREAD_UPDATED
  THREAD_PINNED
  THREAD_UNPINNED
  THREAD_CLOSED
  THREAD_REOPENED
  THREAD_DELETED
  THREAD_RESTORED
  POST_CREATED
  POST_UPDATED
  POST_DELETED
  POST_RESTORED
  POST_MARKED_RESOLVED
  POST_UNMARKED_RESOLVED
  REPORT_CREATED
  REPORT_REVIEWED
  REPORT_DISMISSED
  SPACE_ARCHIVED
  SPACE_RESTORED
  SPACE_DELETED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentWebhookEventStatus {
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
  IGNORED
}

model LibraryResource {
  id           String                    @id @default(cuid())
  title        String
  description  String?                   @db.LongText
  fileName     String
  fileUrl      String                    @db.LongText
  fileKey      String?
  externalUrl  String?                   @db.LongText
  mimeType     String
  fileSize     Int
  type         LibraryResourceType
  category     LibraryResourceCategory?
  audience     LibraryResourceAudience?
  visibility   LibraryVisibility         @default(PRIVATE)
  status       LibraryResourceStatus     @default(PUBLISHED)
  courseId     String?
  folderId     String?
  uploadedById String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  folder       LibraryFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   User                      @relation("LibraryResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById, createdAt])
  @@index([courseId, visibility])
  @@index([folderId, createdAt])
  @@index([type, visibility, createdAt])
  @@index([status, visibility, createdAt])
}

model LibraryFolder {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.LongText
  courseId    String?
  parentId    String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course    Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  parent    LibraryFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  LibraryFolder[] @relation("FolderTree")
  resources LibraryResource[]
  createdBy User            @relation("LibraryFolderCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([courseId])
  @@index([parentId])
}

enum LibraryResourceType {
  PDF
  VIDEO
  PRESENTATION
  DOCUMENT
  IMAGE
  LINK
  OTHER
}

enum LibraryResourceStatus {
  DRAFT
  PUBLISHED
}

enum LibraryResourceAudience {
  ALL
  STUDENTS
  FAMILIES
  PROFESSIONALS
}

enum LibraryResourceCategory {
  GUIDE
  TEMPLATE
  WEBINAR
  CASE_STUDY
  MATERIAL
  FAMILY_RESOURCE
  PROFESSIONAL_RESOURCE
  OTHER
}

enum LibraryVisibility {
  PUBLIC
  ENROLLED_STUDENTS
  COURSE_ONLY
  TEACHERS_ONLY
  PRIVATE
}

model CalendarEvent {
  id          String                  @id @default(cuid())
  title       String
  description String?                 @db.LongText
  type        CalendarEventType
  status      CalendarEventStatus     @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  courseId    String?
  createdById String
  meetingUrl  String?
  location    String?
  visibility  CalendarEventVisibility @default(COURSE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy User    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([startsAt, status])
  @@index([courseId, startsAt])
  @@index([createdById, startsAt])
  @@index([visibility, startsAt])
}

model RubricCriterion {
  id          String   @id @default(cuid())
  resourceId  String
  title       String
  description String?  @db.LongText
  maxPoints   Float
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resource    CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  scores      RubricScore[]

  @@index([resourceId, order])
}

model RubricScore {
  id           String   @id @default(cuid())
  submissionId String
  criterionId  String
  points       Float    @default(0)
  comment      String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission   CourseResourceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion          @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([submissionId])
  @@index([criterionId])
}

enum CalendarEventType {
  LIVE_WEBINAR
  GROUP_TUTORING
  INDIVIDUAL_TUTORING
  ASSIGNMENT_DEADLINE
  EVALUATION
  LIVE_CLASS
  INFO_SESSION
}

enum CalendarEventStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  EXPIRED
}

enum CalendarEventVisibility {
  PUBLIC
  COURSE
  TEACHERS_ONLY
  ADMIN_ONLY
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}
